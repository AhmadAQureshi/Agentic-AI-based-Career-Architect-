{
  "match_threshold": 80,
  "human_approval_required": true,
  "auto_submit_enabled": false,
  "kill_switch_enabled": false,
  "retention_days": 180,
  "allowed_output_actions": [
    "draft_cv",
    "draft_cover_letter",
    "notify_user",
    "track_status"
  ],
  "blocked_output_actions": [
    "auto_submit_without_approval",
    "fabricate_experience",
    "store_plaintext_passwords"
  ],
  "notification": {
    "email_enabled": false,
    "mobile_webhook_enabled": false
  },
  "llm": {
    "provider": "template_or_openai",
    "source_grounding_required": true,
    "temperature": 0.2
  }
}